# Copy to .env and fill in. .env is gitignored.
OPENAI_API_KEY=sk-...

# Model tiers. Swap freely - every call site reads these.
EXTRACTOR_MODEL=gpt-4.1
CHEAP_MODEL=gpt-4.1-mini

# Cost + loop guards (hard stops, enforced in code)
MAX_USD_PER_DOCUMENT=0.25
MAX_LLM_CALLS_PER_RUN=12
LLM_TIMEOUT_SECONDS=90

# Confidence thresholds
AUTO_APPROVE_MIN_CONFIDENCE=0.85
UNCERTAIN_BELOW=0.60
USE_OCR=true
